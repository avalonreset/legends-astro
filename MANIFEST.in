recursive-include canary *.json *.mjs *.astro *.md *.ts *.js *.svg
recursive-include tests *.py
recursive-include assets *.png *.webp *.json
recursive-include .github *.yml *.md
prune canary/node_modules
prune canary/dist
prune canary/.astro
