include LICENSE README.md AGENTS.md SECURITY.md CHANGELOG.md THIRD_PARTY_NOTICES.md CONTRIBUTING.md
include NOTICE CITATION.cff SUPPORT.md CODE_OF_CONDUCT.md package.json
recursive-include wiki *.md
recursive-include references *.md
recursive-include templates *.md
recursive-include docs *.md *.json
recursive-include knowledge *.md *.json
recursive-include skills *.md
recursive-include scripts *.py *.mjs
