---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
}

const { title, description, canonical } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" style="background:#000;color-scheme:dark">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="theme-color" content="#000000"/>
<meta name="color-scheme" content="dark"/>
<style is:inline data-first-paint-black>html,body{margin:0;background:#000;color:#fff}</style>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
</head>
<body>
<script is:inline defer src="/gate-frame-guard-v1.js"></script>
<slot />
<slot name="scripts" />
</body>
</html>
